[Unit]
Description=Argus USB event capture agent
Wants=usbguard.service
After=usbguard.service
Documentation=https://github.com/cristianrubioa/argus

[Service]
Type=simple
User=argus-agent
# Must come after EnvironmentFile= so this host path always wins (later directive wins).
EnvironmentFile=-/etc/argus/agent.env
Environment=ARGUS_DB_PATH=/var/lib/argus/argus.db
ExecStart=/opt/argus/app/.venv/bin/argus-agent
Restart=on-failure

[Install]
WantedBy=multi-user.target
