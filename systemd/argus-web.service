[Unit]
Description=Argus dashboard
PartOf=argus.target
Documentation=https://github.com/cristianrubioa/argus

[Service]
Type=simple
User=argus-agent
EnvironmentFile=-/etc/argus/agent.env
Environment=ARGUS_DB_PATH=/var/lib/argus/argus.db
ExecStart=/opt/argus/bin/argus-web
Restart=on-failure

[Install]
WantedBy=multi-user.target
