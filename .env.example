# Copy to .env and fill in.

# Admin login (seeded into the database on first start; safe to change later
# by editing the admin user directly — these env vars only seed/reset it).
ARGUS_ADMIN_USERNAME=admin
ARGUS_ADMIN_PASSWORD=change-me

# Random string used to sign the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
ARGUS_SESSION_SECRET=

# SQLite path, shared between argus-web (Docker) and argus-agent (host) via
# a bind mount — see README for the install order.
ARGUS_DB_PATH=/data/argus.db

# Optional: MQTT broker for the automation event bridge. Leave ARGUS_MQTT_HOST
# empty to disable it entirely — nothing else depends on it.
ARGUS_MQTT_HOST=
ARGUS_MQTT_PORT=1883
ARGUS_MQTT_TOPIC_PREFIX=argus
