# Copy to .env and fill in.

# Admin login, seeded into the database on first start.
ARGUS_ADMIN_USERNAME=admin
ARGUS_ADMIN_PASSWORD=change-me

# Session cookie signing key: python -c "import secrets; print(secrets.token_hex(32))"
ARGUS_SESSION_SECRET=

# ARGUS_DB_PATH not set here on purpose — docker-compose.yml and argus-agent.service each hardcode their own.

# Optional MQTT broker for the automation bridge; leave ARGUS_MQTT_HOST empty to disable it.
ARGUS_MQTT_HOST=
ARGUS_MQTT_PORT=1883
ARGUS_MQTT_TOPIC_PREFIX=argus
