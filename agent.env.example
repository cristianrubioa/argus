# This file becomes /etc/argus/agent.env on install. Everything below is commented out —
# argus-agent and argus-web already have working defaults for all of it. Uncomment only what
# you want to change, then `systemctl restart argus.target`.
# The admin account isn't set here — create it in the browser on first visit.

# Session cookie signing key. Only set this for a fixed, known value — by default argus-web
# generates and persists its own the first time it starts.
# ARGUS_SESSION_SECRET=

# Restrict the session cookie to HTTPS. Only set true if Argus sits behind a TLS-terminating
# reverse proxy — leave commented for plain-HTTP-on-LAN setups (the default install).
# ARGUS_SESSION_HTTPS_ONLY=true

# ARGUS_DB_PATH not set here on purpose — argus-agent.service and argus-web.service each hardcode it.

# Optional MQTT broker for the automation bridge; uncomment ARGUS_MQTT_HOST to enable it.
# ARGUS_MQTT_HOST=
# ARGUS_MQTT_PORT=1883
# ARGUS_MQTT_TOPIC_PREFIX=argus

# Optional: days of event history to keep before argus-agent starts deleting old rows.
# Leave commented to keep everything forever (the default). This is permanent and irreversible
# once enabled — device_events is a security audit log, only turn this on if you mean it.
# ARGUS_LOG_RETENTION_DAYS=
